{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "shouldTranslate": false
    },
    "%lld fps": {
      "shouldTranslate": false
    },
    "%lld videos": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld video"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld videos"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个视频"
          }
        }
      }
    },
    "%lld × %lld": {
      "shouldTranslate": false
    },
    "A newer version of Phosphene is ready when you are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Phosphene 的新版本已就绪，随时可以安装。"
          }
        }
      }
    },
    "About Phosphene": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Phosphene"
          }
        }
      }
    },
    "Add Video": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加视频"
          }
        }
      }
    },
    "Add a video to use as your wallpaper.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个视频用作墙纸。"
          }
        }
      }
    },
    "Add a video to your Library\nto get started": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将视频添加到资料库\n即可开始使用"
          }
        }
      }
    },
    "Are you sure you want to remove \"%@\" from your library?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要从资料库中移除“%@”吗？"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Balanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡"
          }
        }
      }
    },
    "Battery Saver": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "省电"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cannot access the video file for '%@'. Please make sure the file still exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问“%@”的视频文件。请确保该文件仍然存在。"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取"
          }
        }
      }
    },
    "Choose the wallpaper in macOS Wallpaper Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS“墙纸”设置中选取墙纸"
          }
        }
      }
    },
    "Click to rename — the name also shows in the System Settings wallpaper picker": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以重命名——此名称也会显示在“系统设置”的墙纸选择器中"
          }
        }
      }
    },
    "Couldn't download the update. Check your connection, or get it from the releases page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载更新。请检查网络连接，或从发布页面获取。"
          }
        }
      }
    },
    "Couldn't find a download for this update. Get it from the releases page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此更新的下载文件。请从发布页面获取。"
          }
        }
      }
    },
    "Couldn't load the release notes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入更新说明。"
          }
        }
      }
    },
    "Create Variants": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建优化版本"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
