    "Sevoflurane runs Windows Steam on your Mac. It’s free, from the maker of Phosphene.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevoflurane 能在你的 Mac 上运行 Windows 版 Steam。它是免费的，出自 Phosphene 的开发者。"
          }
        }
      }
    },
    "Show Downloads": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示下载内容"
