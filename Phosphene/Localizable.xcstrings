    "Display": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Downscales to 1080p with reduced frame rate tiers. Best for laptops on battery.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小到 1080p 并生成较低帧率的版本。最适合使用电池的笔记本电脑。"
          }
        }
      }
    },
    "Everywhere": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "Force-restart the system WallpaperAgent if the wallpaper is stuck or wrong.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果墙纸卡住或显示不正确，强制重新启动系统的 WallpaperAgent。"
          }
        }
      }
    },
    "Hide Inspector": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏检查器"
          }
        }
      }
    },
    "I couldn't find a wallpaper named '%@'. Available wallpapers: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到名为“%1$@”的墙纸。可用的墙纸：%2$@"
          }
        }
      }
    },
    "In use as wallpaper": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正用作墙纸"
          }
        }
      }
    },
    "In use on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在 %@ 上使用"
          }
        }
      }
    },
    "Install updates automatically": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动安装更新"
          }
        }
      }
    },
    "It will install itself when your Mac is idle — the wallpaper keeps playing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会在你的 Mac 空闲时自动安装——墙纸会持续播放。"
          }
        }
      }
    },
    "Keeps original resolution, creates lower frame rate tiers for power-saving modes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原始分辨率，并为省电模式生成较低帧率的版本。"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        }
      }
    },
