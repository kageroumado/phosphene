      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被遮挡时暂停"
          }
        }
      }
    },
    "Pause playback on displays fully covered by windows. Fullscreen apps and games always pause their display.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当显示器被窗口完全遮挡时暂停播放。全屏幕 App 和游戏始终会暂停其所在显示器的播放。"
          }
        }
      }
    },
    "Paused": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        }
      }
